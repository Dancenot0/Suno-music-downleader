        <Icon Id="IconoSuno" SourceFile="C:\Users\vejie\AppData\Local\Temp\opencode\msi\Icon\IconoSuno" />
        <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de [ProductName] instalada." Schedule="afterInstallValidate" />
        <Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" />
        <Media Id="2" Cabinet="cab2.cab" EmbedCab="yes" />
        <Property Id="ALLUSERS" Value="1" />
        <Property Id="ARPPRODUCTICON" Value="IconoSuno" />
        <Property Id="ARPCOMMENTS" Value="Descargador de playlists públicas de Suno" />
        <Property Id="DESKTOP_SHORTCUT" Secure="yes" />
        <Property Id="START_SHORTCUT" Secure="yes" />
        <Property Id="WIX_DOWNGRADE_DETECTED" Secure="yes" />
        <Property Id="WIX_UPGRADE_DETECTED" Secure="yes" />
        <UI>
            <Dialog Id="AccesosDlg" X="50" Y="50" Width="370" Height="270" Title="Suno v1 · Accesos directos" NoMinimize="yes">
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Text="WixUI_Bmp_Dialog" TabSkip="no" Disabled="yes" />
                <Control Id="StartMenuCheck" Type="CheckBox" X="24" Y="78" Width="330" Height="18" Property="START_SHORTCUT" Text="En el menú Inicio" CheckBoxValue="1" TabSkip="no" />
                <Control Id="DesktopCheck" Type="CheckBox" X="24" Y="104" Width="330" Height="18" Property="DESKTOP_SHORTCUT" Text="En el escritorio" CheckBoxValue="1" TabSkip="no" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Atrás" TabSkip="no">
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="Siguiente" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancelar" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Description" Type="Text" X="24" Y="42" Width="320" Height="16" Text="Elige dónde quieres abrir Suno v1." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Title" Type="Text" X="24" Y="20" Width="320" Height="18" Text="Accesos directos" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Hint" Type="Text" X="24" Y="140" Width="320" Height="30" Text="Si cambias de idea, vuelve a ejecutar el instalador." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
            </Dialog>
        </UI>
        <UIRef Id="WixUI_InstallDir" />
        <InstallExecuteSequence>
            <Custom Action="EscritorioPorDefecto" Before="InicioPorDefecto">NOT DESKTOP_SHORTCUT</Custom>
            <Custom Action="InicioPorDefecto" Before="CostInitialize">NOT START_SHORTCUT</Custom>
        </InstallExecuteSequence>
        <InstallUISequence>
            <Custom Action="EscritorioPorDefecto" Before="InicioPorDefecto">NOT DESKTOP_SHORTCUT</Custom>
            <Custom Action="InicioPorDefecto" Before="CostInitialize">NOT START_SHORTCUT</Custom>
        </InstallUISequence>
    </Product>
</Wix>